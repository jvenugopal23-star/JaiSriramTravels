<!DOCTYPE html>
<html>
<head>
    <title>All Bookings</title>

    <style>
        body{
            font-family: Arial, sans-serif;
            background:#f4f4f4;
            padding:20px;
        }

        h2{
            text-align:center;
            color:#0d1b2a;
        }

        table{
            width:90%;
            margin:auto;
            border-collapse:collapse;
            background:white;
        }

        th{
            background:#ff9800;
            color:white;
            padding:12px;
        }

        td{
            border:1px solid #ddd;
            padding:10px;
            text-align:center;
        }

        tr:nth-child(even){
            background:#f9f9f9;
        }

        tr:hover{
            background:#eeeeee;
        }

        .chart-box{
            width:80%;
            margin:auto;
            margin-bottom:30px;
        }
    </style>
</head>
<body>

<h2>Jai Sriram Travels - All Bookings</h2>

<div style="
display:flex;
justify-content:center;
gap:20px;
margin:20px;
flex-wrap:wrap;
">

    <div style="
    background:#2196F3;
    color:white;
    padding:20px;
    border-radius:10px;
    min-width:150px;
    text-align:center;">
        <h3>Total</h3>
        <h2><%= totalBookings %></h2>
    </div>

    <div style="
    background:orange;
    color:white;
    padding:20px;
    border-radius:10px;
    min-width:150px;
    text-align:center;">
        <h3>Pending</h3>
        <h2><%= pendingBookings %></h2>
    </div>

    <div style="
    background:green;
    color:white;
    padding:20px;
    border-radius:10px;
    min-width:150px;
    text-align:center;">
        <h3>Confirmed</h3>
        <h2><%= confirmedBookings %></h2>
    </div>

</div>

<!-- Booking Charts -->

<h3 style="text-align:center;">📊 Booking Statistics</h3>

<div class="chart-box">

    <p><b>Confirmed Bookings</b></p>

    <div style="
    background:#ddd;
    height:30px;
    border-radius:20px;
    overflow:hidden;
    margin-bottom:20px;">

        <div style="
        width:<%= confirmedPercent %>%;
        background:green;
        height:30px;
        color:white;
        text-align:center;
        line-height:30px;">
            <%= confirmedBookings %>
        </div>

    </div>

    <p><b>Pending Bookings</b></p>

    <div style="
    background:#ddd;
    height:30px;
    border-radius:20px;
    overflow:hidden;">

        <div style="
        width:<%= pendingPercent %>%;
        background:orange;
        height:30px;
        color:white;
        text-align:center;
        line-height:30px;">
            <%= pendingBookings %>
        </div>

    </div>

</div>

<div style="text-align:center;">
    <input
        type="text"
        id="searchInput"
        placeholder="Search by Name..."
        style="padding:10px; width:300px;">
</div>

<br>

<table>
    <tr>
        <th>Name</th>
        <th>Phone</th>
        <th>Pickup</th>
        <th>Vehicle</th>
        <th>Destination</th>
        <th>Date</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    <% bookings.forEach(function(b){ %>

    <tr>
        <td><%= b.name %></td>
        <td><%= b.phone %></td>
        <td><%= b.pickup %></td>
        <td><%= b.vehicle %></td>
        <td><%= b.destination %></td>
        <td><%= b.date %></td>

        <td>
            <% if(b.status === "Confirmed") { %>

                <span style="color:green;font-weight:bold;">
                    ✅ Confirmed
                </span>

            <% } else { %>

                <span style="color:orange;font-weight:bold;">
                    ⏳ Pending
                </span>

            <% } %>
        </td>

        <td>
            <a href="/confirm/<%= b._id %>">
                 Confirm
            </a>

            |

            <a href="/delete/<%= b._id %>">
                Delete
            </a>

            |

            <a href="/receipt/<%= b._id %>">
                📄 Receipt
            </a>
        </td>
    </tr>

    <% }) %>

</table>

<script>

document.getElementById("searchInput")
.addEventListener("keyup", function() {

    let value = this.value.toLowerCase();

    let rows = document.querySelectorAll("table tr");

    rows.forEach((row, index) => {

        if(index === 0) return;

        let text = row.innerText.toLowerCase();

        row.style.display =
            text.includes(value) ? "" : "none";

    });

});

</script>

</body>
</html>