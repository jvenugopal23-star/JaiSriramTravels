<!DOCTYPE html>
<html>
<head>
    <title>Jai Sriram Tours & Travels</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial,sans-serif;
        }

        nav{
            background:#0d1b2a;
            color:white;
            padding:15px 30px;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }

        nav ul{
            list-style:none;
            display:flex;
            gap:20px;
        }

        nav a{
            color:white;
            text-decoration:none;
        }

        .hero{
            height:90vh;
            background:linear-gradient(rgba(0,0,0,0.5),
            rgba(0,0,0,0.5)),
            url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e');
            background-size:cover;
            background-position:center;
            color:white;
            display:flex;
            justify-content:center;
            align-items:center;
            text-align:center;
        }

        .hero h1{
            font-size:50px;
        }

        .hero p{
            margin-top:15px;
            font-size:20px;
        }

        .btn{
            margin-top:20px;
            padding:12px 25px;
            background:#ff9800;
            color:white;
            border:none;
            border-radius:5px;
            cursor:pointer;
            font-size:18px;
            transition:0.3s;
        }

        .btn:hover{
            background:#e68900;
        }

        .section{
            padding:50px;
            text-align:center;
        }

        .cards{
            display:flex;
            justify-content:center;
            gap:20px;
            flex-wrap:wrap;
        }

        .card{
            border:1px solid #ddd;
            padding:20px;
            width:280px;
            border-radius:10px;
            box-shadow:0 4px 10px rgba(0,0,0,0.1);
            transition:0.3s;
            background:white;
        }

        .card:hover{
            transform:translateY(-5px); 
        }   

        .card img{
            width:100%;
            height:180px;
            object-fit:cover;
            border-radius:10px;
            margin-bottom:10px;
        }

        .card button{
            margin-top:10px;
            padding:10px 15px;
            background:orange;
            border:none;
            cursor:pointer;
        }

        .tour-section{
            background:#f5f5f5;
            padding:50px;
            text-align:center;
        }

        form{
            max-width:500px;
            margin:auto;
        }

        form input{
            width:100%;
            padding:10px;
            margin:10px 0;
        }

        .submit-btn{
            padding:12px 25px;
            background:orange;
            border:none;
            cursor:pointer;
        }

        #message{
            margin-top:20px;
            color:green;
            font-weight:bold;
        }

        .contact{
            background:#0d1b2a;
            color:white;
            padding:40px;
            text-align:center;
        }

        .contact p{
            margin-top:10px;
        }
    select{
    width:100%;
    padding:10px;
    margin:10px 0;
}

button{
    border-radius:5px;
}

h2{
    margin-bottom:20px;
}   
    </style>
</head>

<body>

<nav>
    <h2>🚗 Jai Sriram Travels</h2>

    <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#vehicles">Vehicles</a></li>
        <li><a href="#tours">Tours</a></li>
        <li><a href="#contact">Contact</a></li>
    </ul>
</nav>

<section class="hero">
    <div>
        <h1>Explore The World With Us</h1>
        <p>Book Cars, SUVs and Tour Packages Easily</p>

        <a href="#booking">
            <button class="btn">Book Now</button>
        </a>
    </div>
</section>

<section id="vehicles" class="section">
    <h2>Our Vehicles</h2>
    <br>

    <div class="cards">

       <div class="card">
            <img src="/innova.jpeg" width="220" height="150">
            <h3>🚘 Innova</h3>
            <p>7 Seater</p>
            <p>₹18 per KM</p>
            <button>Book Now</button>
        </div>

        <div class="card">
            <img src="/etios.jpeg" width="220" height="150">
            <h3>🚗 Etios</h3>
            <p>4 Seater</p>
            <p>₹14 per KM</p>
            <button>Book Now</button>
        </div>

        <div class="card">
            <img src="/tempo.jpeg" width="220" height="150">
            <h3>🚌 Tempo Traveller</h3>
            <p>12 Seater</p>
            <p>₹25 per KM</p>
            <button>Book Now</button>
        </div>

    </div>
</section>

<section id="tours" class="tour-section">
    <h2>Popular Tour Packages</h2>
    <br>

    <div class="cards">

        <div class="card">
            <h3>🏛 Tirupati Tour</h3>
            <p>1 Day Package</p>
            <p>Starting ₹4,999</p>
        </div>

        <div class="card">
            <h3>🏞 Araku Valley</h3>
            <p>2 Days Package</p>
            <p>Starting ₹8,999</p>
        </div>

        <div class="card">
            <h3>🌊 Visakhapatnam</h3>
            <p>3 Days Package</p>
            <p>Starting ₹12,999</p>
        </div>

    </div>
</section>

<section id="booking" class="section">

    <h2>Book Your Vehicle</h2>

    <form action="/book" method="POST">
        <input type="text" name="name" placeholder="Enter Your Name" required>

        <input type="text" name="phone" placeholder="Phone Number" required>

        <input type="text" name="pickup" placeholder="Pickup Location" required>
        <select name="vehicle" required>
            <option value="">Select Vehicle</option>
            <option>Innova</option>
            <option>Etios</option>
            <option>Tempo Traveller</option>
        </select>
        <input type="text" name="destination" placeholder="Destination" required>

        <input type="date" name="date" required>
        <label>Distance (KM)</label>
        <input type="number" id="distance" placeholder="Enter Distance">

        <button type="button" onclick="calculateFare()">
             Calculate Fare
        </button>

        <h3 id="fareResult"></h3>

        <button type="submit" class="submit-btn">
            Submit Booking
        </button>

    </form>

    <div id="message"></div>

</section>
<section class="section">

    <h2>Customer Reviews</h2>
    <form action="/reviews" method="POST" style="max-width:500px; margin:20px auto;">

        <input
            type="text"
            name="name"
            placeholder="Your Name"
            required>

        <select name="rating" required>
            <option value="">Select Rating</option>
            <option value="5">⭐⭐⭐⭐⭐ 5 Stars</option>
            <option value="4">⭐⭐⭐⭐ 4 Stars</option>
            <option value="3">⭐⭐⭐ 3 Stars</option>
            <option value="2">⭐⭐ 2 Stars</option>
            <option value="1">⭐ 1 Star</option>
        </select>

        <textarea
            name="comment"
            placeholder="Write your review"
            required
            style="width:100%; padding:10px; margin:10px 0; height:100px;">
        </textarea>

        <button type="submit" class="submit-btn">
            Submit Review
        </button>

    </form>
    <!-- your existing review cards are below -->

    <div class="cards" id="reviewsContainer">
        <p>Loading reviews...</p>
    </div>

</section>

<section id="contact" class="contact">

    <h2>Contact Us</h2>

    <p>📞 Phone: 6281060843</p>

    <p>📧 Email: jaisriramtravels@gmail.com</p>

    <p>📍 Location: Madanapalle, Andhra Pradesh</p>
    
    <br>

    <a
        href="https://www.google.com/maps/dir/?api=1&destination=Madanapalle,Andhra+Pradesh"
        target="_blank"
        style="
            display:inline-block;
            margin-top:15px;
            padding:12px 25px;
            background:#2196F3;
            color:white;
            text-decoration:none;
            border-radius:5px;
            font-weight:bold;">
        🗺️ Get Directions
    </a>
    <iframe
        src="https://www.google.com/maps?q=Madanapalle,Andhra+Pradesh&output=embed"
        width="100%"
        height="300"
        style="border:0;"
        allowfullscreen=""
        loading="lazy">
    </iframe>
    <a href="https://wa.me/916281060843" target="_blank">
    <button style="
        background:#25D366;
        color:white;
        padding:12px 20px;
        border:none;
        border-radius:5px;
        cursor:pointer;
        font-size:16px;
        margin-top:15px;">
        💬 WhatsApp Us
    </button>
</a>
    

</section>


<script>
function calculateFare() {

    let distance = document.getElementById("distance").value;

    let vehicle = document.getElementsByName("vehicle")[0].value;

    let rate = 0;

    if(vehicle === "Innova") {
        rate = 18;
    }
    else if(vehicle === "Etios") {
        rate = 14;
    }
    else if(vehicle === "Tempo Traveller") {
        rate = 25;
    }

    let total = distance * rate;

    document.getElementById("fareResult").innerHTML =
        "Estimated Fare: ₹" + total;
}
</script>
<script>
async function loadReviews() {

    try {
        const response = await fetch("/reviews");
        const reviews = await response.json();

        const container = document.getElementById("reviewsContainer");

        container.innerHTML = "";

        if (reviews.length === 0) {
            container.innerHTML = "<p>No reviews yet.</p>";
            return;
        }

        reviews.forEach(function(review) {

            let stars = "⭐".repeat(review.rating);

            container.innerHTML += `
                <div class="card">
                    <h3>${stars}</h3>
                    <p>"${review.comment}"</p>
                    <strong>- ${review.name}</strong>
                </div>
            `;

        });

    } catch (error) {

        console.log(error);

        document.getElementById("reviewsContainer").innerHTML =
            "<p>Unable to load reviews.</p>";
    }
}

loadReviews();
</script>
</body>
</html>